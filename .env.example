# Example .env file for local development
# Copy this to .env and fill in your actual values. Add .env to .gitignore

# --- Required --- 
OPENAI_API_KEY="sk-..."
DOCUMENTS_S3_BUCKET="your-local-dev-s3-bucket-or-mock"
CHROMA_HOST="localhost" # Or the host of your local ChromaDB instance/container

# --- Optional (defaults are in src/config.py) ---
# CHROMA_PORT=8000
# CHROMA_COLLECTION="documents"
# OPENAI_EMBEDDING_MODEL="text-embedding-ada-002"
# OPENAI_CHAT_MODEL="gpt-3.5-turbo"
# AWS_REGION="us-east-1" # If using AWS services locally (e.g., S3 with localstack or real AWS) 